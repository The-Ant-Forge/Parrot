{
  "name": "parrot",
  "version": "1.28.1",
  "description": "Browser extension that checks if media you're browsing is already in your Plex library",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "prebuild": "node scripts/bump-build.js",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "version:commit": "node scripts/bump-commit.js",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "wiki:sync": "node scripts/sync-wiki.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
